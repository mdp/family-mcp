{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "family-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-13",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,

  "kv_namespaces": [
    {
      "binding": "STATE_KV",
      "id": "5ffd7d21fd434df5be91c18bb2b7fca8"
    },
    {
      "binding": "TOKENS_KV",
      "id": "715ed22e1daa4b01aa11c5a32b80bb42"
    }
  ],

  "vars": {
    "ALLOWED_EMAILS": "percival@gmail.com,alainapercival@gmail.com",
    "ALLOWED_EXTERNAL_RECIPIENTS": ""
  },

  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 10 }
    }
  ],

  "observability": {
    "enabled": true
  },

  "dev": {
    "port": 8788
  }

  // Secrets — set via: wrangler secret put <NAME>
  // Required:
  //   GOOGLE_CLIENT_ID
  //   GOOGLE_CLIENT_SECRET
  //   JWT_SECRET              (generate: openssl rand -hex 32)
  //
  // KV namespaces — create via:
  //   wrangler kv namespace create STATE_KV
  //   wrangler kv namespace create TOKENS_KV
  // Then replace the TODO IDs above with the returned namespace IDs.
}
